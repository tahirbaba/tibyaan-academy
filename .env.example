# =============================================================================
# Tibyaan Academy — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Authentication + Storage)
# https://supabase.com/dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Neon PostgreSQL (Database)
# https://console.neon.tech → Connection Details
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Anthropic Claude AI (AI Ustaz + Blog Generation)
# https://console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Groq (Whisper Large v3 — Audio Transcription)
# https://console.groq.com → API Keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_...

# -----------------------------------------------------------------------------
# Stripe (Payments)
# https://dashboard.stripe.com → Developers → API Keys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Resend (Transactional Email)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Canonical public base URL — the single source of truth for every generated URL
# (metadataBase, canonicals, hreflang, sitemap, robots, RSS, share & referral links).
# REQUIRED: a production build fails without it (next.config.ts). Only `next dev`
# falls back to http://localhost:3000. Production & Preview: https://tibyaanacademy.com
NEXT_PUBLIC_SITE_URL=https://tibyaanacademy.com

# The one real support/notification mailbox — shown to users and used as the
# From: address on transactional mail.
SUPPORT_EMAIL=academytibyaan@gmail.com

# Recordings cleanup. PAUSED unless this is exactly "true".
# When enabled, the daily cron permanently deletes expired class recordings from
# Supabase Storage - there is no backup of that bucket. Changing this needs a
# redeploy: a function keeps the environment it was deployed with.
RECORDINGS_CLEANUP_ENABLED=false

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# Admin Contact
# -----------------------------------------------------------------------------
ADMIN_EMAIL=academytibyaan@gmail.com
ADMIN_WHATSAPP=+923129114002

# -----------------------------------------------------------------------------
# Cron & Admin Secrets
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=your-cron-secret
ADMIN_SECRET=your-admin-secret

# -----------------------------------------------------------------------------
# Inngest (Background Jobs & Automation)
# https://app.inngest.com → Manage → Event Keys
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# -----------------------------------------------------------------------------
# Google APIs (SEO)
# https://console.cloud.google.com → APIs & Services
# -----------------------------------------------------------------------------
GOOGLE_SEARCH_CONSOLE_API_KEY=your-google-search-console-key
GOOGLE_INDEXING_API_KEY=your-google-indexing-api-key

# -----------------------------------------------------------------------------
# Gemini AI (Blog UI Rendering — Optional)
# https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# WhatsApp Business API (Automation Workflows)
# https://developers.facebook.com/docs/whatsapp
# -----------------------------------------------------------------------------
WHATSAPP_API_KEY=your-whatsapp-business-api-key

# -----------------------------------------------------------------------------
# Sentry (Error Tracking — Optional)
# https://sentry.io → Settings → Client Keys (DSN)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-key@sentry.io/your-project
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project
