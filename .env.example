# =============================================================================
# Tibyaan Academy — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Authentication + Storage)
# https://supabase.com/dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Neon PostgreSQL (Database)
# https://console.neon.tech → Connection Details
# -----------------------------------------------------------------------------
# DATABASE_URL is the pooled connection used by the app at runtime.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DIRECT_URL is the non-pooled connection used by Drizzle migrations
# (drizzle.config.ts) and the maintenance scripts in scripts/. Required to run
# a migration. Keep it Sensitive in Vercel.
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Anthropic Claude AI (AI Ustaz + Blog Generation)
# https://console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Groq (Whisper Large v3 — Audio Transcription)
# https://console.groq.com → API Keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_...

# -----------------------------------------------------------------------------
# Stripe (Payments)
# https://dashboard.stripe.com → Developers → API Keys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Resend (Transactional Email)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Canonical public base URL — the single source of truth for every generated URL
# (metadataBase, canonicals, hreflang, sitemap, robots, RSS, share & referral links).
# REQUIRED: a production build fails without it (next.config.ts). Only `next dev`
# falls back to http://localhost:3000. Production & Preview: https://tibyaanacademy.com
NEXT_PUBLIC_SITE_URL=https://tibyaanacademy.com

# The one real support/notification mailbox — shown to users and used as the
# From: address on transactional mail.
SUPPORT_EMAIL=academytibyaan@gmail.com

# (Recordings cleanup cron removed in Phase 13 — class recordings now live in the
# tibyaan-recordings R2 bucket, whose Cloudflare lifecycle rule deletes objects 3
# days after creation. A storage rule cannot fail silently the way a cron can.)

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# Admin Contact
# (ADMIN_EMAIL removed — no code reads it; the live admin address is SUPPORT_EMAIL.)
# -----------------------------------------------------------------------------
ADMIN_WHATSAPP=+923129114002

# -----------------------------------------------------------------------------
# Cron & Admin Secrets
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=your-cron-secret
ADMIN_SECRET=your-admin-secret

# -----------------------------------------------------------------------------
# Inngest (Background Jobs & Automation)
# https://app.inngest.com → Manage → Event Keys
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# (Removed: GOOGLE_SEARCH_CONSOLE_API_KEY, GOOGLE_INDEXING_API_KEY, GEMINI_API_KEY
#  — no code reads any of them.)

# -----------------------------------------------------------------------------
# WhatsApp Business API (parent reports)
# https://developers.facebook.com/docs/whatsapp
# -----------------------------------------------------------------------------
# The live WhatsApp sender (lib/whatsapp/send-message.ts) reads these two.
# Both are needed together; leave unset to disable WhatsApp sending.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# WHATSAPP_API_KEY is read only by the Inngest automation path, which is off
# until the Inngest keys are set. Kept for that path; consolidate when Inngest
# is decided.
WHATSAPP_API_KEY=your-whatsapp-business-api-key

# -----------------------------------------------------------------------------
# Twilio (fallback WhatsApp channel for parent alerts — optional)
# Read by /api/parent-alert. Leave unset to disable the Twilio branch.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -----------------------------------------------------------------------------
# Scheduled-job feature flags (optional — each gates one cron; unset = off)
# -----------------------------------------------------------------------------
# Hourly dars-circle reminder notifications (/api/dars-circles/reminders).
DARS_CIRCLE_REMINDERS_ENABLED=false
# Sunday weekly WhatsApp parent reports (/api/parent-reports/weekly).
PARENT_REPORTS_ENABLED=false

# -----------------------------------------------------------------------------
# Sentry (Error Tracking — Optional)
# https://sentry.io → Settings → Client Keys (DSN)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-key@sentry.io/your-project
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project

# -----------------------------------------------------------------------------
# Hero video (Optional)
# A YouTube URL for the home page hero. Normal videos and Shorts both work —
# the embed detects a Short and uses a vertical frame for it.
# Leave it unset and the hero shows its designed brand panel instead.
# Changing it needs a redeploy: it is baked in at build time.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_HERO_VIDEO_URL=

# -----------------------------------------------------------------------------
# Guiding videos (Optional — Phase 14b)
# Two short YouTube videos shown on the home page and the signup page: one for
# new students, one for new teachers. Normal videos and Shorts both work.
# If a link is unset or blank, that card does not render at all (no empty box).
# Both are NEXT_PUBLIC_ — baked in at build time, so a redeploy is needed after
# changing either one.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SIGNUP_GUIDING_VIDEO_LINK_STUDENT=
NEXT_PUBLIC_SIGNUP_GUIDING_VIDEO_LINK_TEACHER=

# -----------------------------------------------------------------------------
# Poster Arabic (Optional — leave unset)
# OFF by default. satori renders Arabic unjoined and in reversed word order,
# so an ayah on a poster would be wrong. Correct shaping needs HarfBuzz.
# Do not set this to true on production until the shaping has been verified
# by eye against real ayat.
# -----------------------------------------------------------------------------
POSTER_ARABIC_ENABLED=

# -----------------------------------------------------------------------------
# Alert sender (REQUIRED for failure alerts to be delivered)
# Must be on a domain verified with Resend. A free-mail address (gmail.com etc)
# is refused by every provider, which is how alerts silently went nowhere from
# 11–19 Sep 2026. SUPPORT_EMAIL stays the RECIPIENT; this is only the From:.
# -----------------------------------------------------------------------------
MAIL_FROM_ADDRESS=noreply@tibyaanacademy.com

# -----------------------------------------------------------------------------
# Resend delivery webhook (Phase 2 — email observability)
# Secret from the Resend dashboard webhook you point at /api/webhooks/resend.
# Without it the webhook rejects all events (fails closed), so delivery/bounce
# status is not recorded — set it when the webhook is created.
# -----------------------------------------------------------------------------
RESEND_WEBHOOK_SECRET=
